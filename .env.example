# Environment
ENVIRONMENT=local

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentic_ai

# API Configuration
API_TITLE=Agentic AI FastAPI
API_VERSION=1.0.0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY=your-api-key-here

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO

# Optional: LLM Provider API Keys (agents can use these)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
